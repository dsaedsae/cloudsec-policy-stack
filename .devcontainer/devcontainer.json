// Zero-install browser env (GitHub Codespaces) for the NO-CLUSTER track:
//   M0 (Cedar authz) · M1 (checkov) · M6 (agent-ABAC + ReBAC) · M7 (formal/z3).
// The cluster track (M2-M5, M8) needs kind + ~6-8GB RAM and is best run locally or
// on a larger machine — see labs/SETUP.md.
//
// NOTE: the docker-in-docker feature (needed only for M6 Part B / OpenFGA live
// /check) is temporarily removed: its install runs apt-get update, which fails on
// the base image's expired dl.yarnpkg.com apt key (NO_PUBKEY 62D54FD4003F6525,
// "repository not signed"), so every Codespace build died and silently fell back
// to an alpine (musl) recovery container — where cedarpy/z3 have no wheels and
// build from source for ~1h. Restore the feature once the upstream image/key is
// fixed, or reintroduce it behind a Dockerfile that strips the yarn apt source.
{
  "name": "cloudsec-policy-stack — no-cluster labs",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

  "postCreateCommand": "pip install --no-cache-dir -r requirements-dev.txt",
  "postAttachCommand": "echo 'Ready (glibc, no docker). Start:  python labs/m0/grade.py --ext   |   Track: labs/README.md   |   Progress: python scripts/progress.py'",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "redhat.vscode-yaml",
        "bierner.markdown-mermaid"
      ]
    }
  }
}
